<group name="windows,openssh,">
  <rule id="100100" level="5">
    <if_sid>60009</if_sid>
    <field name="win.system.channel" type="pcre2">^OpenSSH/Operational$</field>
    <field name="win.eventdata.payload" type="pcre2">^Invalid user \S+ from \S+ port \d+$</field>
    <description>Windows OpenSSH: invalid username attempted</description>
    <group>authentication_failed,</group>
  </rule>
</group>
